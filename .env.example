# Copy to .env (repo root or backend/) and adjust. Placeholder values only — never commit real secrets.

# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO
# Default: local SQLite file under backend/var/. For Postgres (docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5432/trading
DATABASE_URL=sqlite:///./var/trading.db

# ---- Market data provider ----
# "sample" = bundled deterministic SIMULATED data (works offline, no credentials)
# "kite"   = Zerodha Kite Connect (read-only). Requires a paid Kite Connect app + daily access token.
DATA_PROVIDER=sample
SAMPLE_SEED=42
SAMPLE_START_DATE=2023-01-02
SAMPLE_INTRADAY_SESSIONS=20

# Zerodha Kite Connect (read-only market data; order APIs are NOT implemented)
# Obtain via the official login flow: https://kite.trade/docs/connect/v3/user/
# Never put your Kite password, PIN or TOTP here or anywhere in this app.
KITE_API_KEY=your-kite-api-key
KITE_API_SECRET=your-kite-api-secret
KITE_ACCESS_TOKEN=

# ---- Execution controls ----
# Live order execution is not implemented in this build. This flag is informational and must stay false.
LIVE_TRADING_ENABLED=false

# ---- AI / LLM ----
# "template" = deterministic explainer (default, no API key, never invents numbers)
# "openai_compatible" = any OpenAI-compatible /chat/completions endpoint
LLM_PROVIDER=template
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=your-model-name

# ---- Background jobs ----
BACKGROUND_JOBS=true
QUOTE_REFRESH_SECONDS=5
