# Copy to .env (repo root or backend/) and adjust. Placeholder values only — never commit real secrets.

# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO
# Default: local SQLite file under backend/var/. For Postgres (docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5432/trading
DATABASE_URL=sqlite:///./var/trading.db

# ---- Market data provider ----
# "yahoo"  (default) = REAL NSE/BSE data from Yahoo Finance via the open-source yfinance library. No account or key.
#                      Unofficial (no public Yahoo API; personal non-commercial use), may be delayed up to ~15 min.
# "upstox" = real-time (zero-delay) NSE/BSE data via Upstox's FREE read-only Analytics Token (1-year validity).
#                      Generate at https://account.upstox.com/developer/apps#analytics  (or paste it in the UI:
#                      Data & Integrations -> Connect). Without a token the app shows SIMULATED data and says so.
# "kite"   = Zerodha Kite Connect (read-only). Requires a paid Kite Connect app + daily access token.
# "sample" = bundled deterministic SIMULATED data (offline).
DATA_PROVIDER=kite
# Optional: comma-separated NSE symbols for live providers (default: a NIFTY 50-style list)
# UNIVERSE=RELIANCE,TCS,HDFCBANK
YAHOO_HISTORY_START=2023-01-01
YAHOO_INTRADAY_DAYS=30
UPSTOX_ACCESS_TOKEN=
# Optional: comma-separated NSE symbols (default: a NIFTY 50-style list)
# UPSTOX_UNIVERSE=RELIANCE,TCS,HDFCBANK
UPSTOX_HISTORY_START=2023-01-01
UPSTOX_INTRADAY_DAYS=30
SAMPLE_SEED=42
SAMPLE_START_DATE=2023-01-02
SAMPLE_INTRADAY_SESSIONS=20

# Zerodha Kite Connect (DEFAULT; read-only market data; order APIs are NOT implemented).
# Easiest: paste the API key/secret in the UI (Data & Integrations) and click "Login with Zerodha" -
# the app then writes KITE_ACCESS_TOKEN / KITE_TOKEN_CREATED here (tokens reset daily ~06:00 IST).
# Register http://127.0.0.1:5173 as your Kite Connect app's Redirect URL.
# Never put your Kite password, PIN or TOTP here or anywhere in this app.
KITE_API_KEY=your-kite-api-key
KITE_API_SECRET=your-kite-api-secret
KITE_ACCESS_TOKEN=
KITE_TOKEN_CREATED=
# Universe and history (Kite): index list refreshed weekly from niftyindices.com (nifty50|nifty100|nifty200|nifty500).
# UNIVERSE (explicit symbols, above) overrides it.
UNIVERSE_INDEX=nifty200
KITE_HISTORY_START=2018-01-01
KITE_INTRADAY_DAYS=30
RESEARCH_INTRADAY_DAYS=365

# Real-time feed: auto (Kite WebSocket when logged in; simulated ticks for sample data) | replay | off
REALTIME_MODE=auto
# REPLAY_DATE=2026-10-15          # replay that session's stored 5-minute bars as ticks
# REPLAY_SPEED=60
# REPLAY_FILE=var/ticks.jsonl     # replay a recorded tick file instead (with REALTIME_MODE=replay)
# RECORD_TICKS=var/ticks.jsonl    # record raw Kite WebSocket frames during market hours

# Strategy tournament worker processes (default: min(cpu-2, 4); each needs ~0.5-1 GB RAM)
# TOURNAMENT_WORKERS=3

# ---- Execution controls ----
# Live order execution is not implemented in this build. This flag is informational and must stay false.
LIVE_TRADING_ENABLED=false

# ---- AI / LLM ----
# "template" = deterministic explainer (default, no API key, never invents numbers)
# "openai_compatible" = any OpenAI-compatible /chat/completions endpoint
LLM_PROVIDER=template
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=your-model-name

# ---- Background jobs ----
BACKGROUND_JOBS=true
QUOTE_REFRESH_SECONDS=5
