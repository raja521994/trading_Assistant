# Initial backend settings on the EC2 host (copied once to /opt/trading/data/backend.env, never overwritten).
# Kite API key/secret are entered in the UI (Data & Integrations) and saved into that file by the app.
APP_ENV=production
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./var/trading.db
DATA_PROVIDER=kite
# Sized for a 1 GB free-tier instance; raise UNIVERSE_INDEX / RESEARCH_INTRADAY_DAYS on a bigger one.
UNIVERSE_INDEX=nifty50
KITE_HISTORY_START=2018-01-01
KITE_INTRADAY_DAYS=30
RESEARCH_INTRADAY_DAYS=90
REALTIME_MODE=auto
LIVE_TRADING_ENABLED=false
LLM_PROVIDER=template
BACKGROUND_JOBS=true
QUOTE_REFRESH_SECONDS=5
TOURNAMENT_WORKERS=1
